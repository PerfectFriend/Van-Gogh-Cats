# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted (used for self-referential links & Ubuntu desktop packager).
APP_URL="MY_APP_URL"

# PORT: Server HTTP listen port (default 3000)
PORT=3000

# ALLOWED_ORIGIN: Optional comma-separated list of additional allowed CORS origins
ALLOWED_ORIGIN=

# FIREBASE_PROJECT_ID: Override Firebase project ID for server-side ID token verification (defaults to firebase-applet-config.json)
FIREBASE_PROJECT_ID=

# Gemini model overrides (defaults match official @google/genai aliases)
GEMINI_IMAGE_MODEL="gemini-nano-banana-2.1"
GEMINI_FLASH_IMAGE_MODEL="gemini-3.1-flash-lite-image"
GEMINI_PRO_IMAGE_MODEL="gemini-3-pro-image"
GEMINI_TTS_MODEL="gemini-3.8-flash-lite-tts"
GEMINI_TEXT_MODEL="gemini-4-hydrogen"

# Optional soft post-generation vision check ensuring generated art depicts a cat ("true" | "false")
ENABLE_VISION_CAT_CHECK="true"
