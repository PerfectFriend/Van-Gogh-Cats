rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net — default deny everything
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Hardened Global Primitives
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isVerifiedUser() && request.auth.uid == userId;
    }

    // 3. Entity Validation Blueprints (exact match to firebase-blueprint.json)
    function isValidPublicProfile(data, userId) {
      return data.keys().hasAll(['uid', 'displayName', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly([
          'uid',
          'displayName',
          'photoURL',
          'preferredStyleId',
          'customStylePrompt',
          'bio',
          'createdAt',
          'updatedAt'
        ])
        && data.uid is string
        && data.uid == userId
        && data.uid == request.auth.uid
        && data.uid.size() >= 1
        && data.uid.size() <= 128
        && data.displayName is string
        && data.displayName.size() >= 1
        && data.displayName.size() <= 100
        && (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 500))
        && (!('preferredStyleId' in data) || (data.preferredStyleId is string && data.preferredStyleId.size() <= 64))
        && (!('customStylePrompt' in data) || (data.customStylePrompt is string && data.customStylePrompt.size() <= 400))
        && (!('bio' in data) || (data.bio is string && data.bio.size() <= 300))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidPrivateAccount(data, userId) {
      return data.keys().hasAll(['uid', 'email', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'email', 'createdAt', 'updatedAt'])
        && data.uid is string
        && data.uid == userId
        && data.uid == request.auth.uid
        && data.uid.size() >= 1
        && data.uid.size() <= 128
        && data.email is string
        && data.email.size() >= 3
        && data.email.size() <= 200
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidCatProfile(data, userId, catId) {
      return data.keys().hasAll(['id', 'ownerUid', 'name', 'breed', 'coatPattern', 'eyeColor', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly([
          'id',
          'ownerUid',
          'name',
          'breed',
          'coatPattern',
          'eyeColor',
          'distinctiveMarks',
          'createdAt',
          'updatedAt'
        ])
        && data.id is string
        && data.id == catId
        && isValidId(data.id)
        && data.ownerUid is string
        && data.ownerUid == userId
        && data.ownerUid == request.auth.uid
        && data.ownerUid.size() >= 1
        && data.ownerUid.size() <= 128
        && data.name is string
        && data.name.size() >= 1
        && data.name.size() <= 80
        && data.breed is string
        && data.breed.size() >= 1
        && data.breed.size() <= 80
        && data.coatPattern is string
        && data.coatPattern.size() >= 1
        && data.coatPattern.size() <= 40
        && data.eyeColor is string
        && data.eyeColor.size() >= 1
        && data.eyeColor.size() <= 40
        && (!('distinctiveMarks' in data) || (data.distinctiveMarks is string && data.distinctiveMarks.size() <= 300))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidArtworkMeta(data, userId, artworkId) {
      return data.keys().hasAll([
          'id',
          'ownerUid',
          'title',
          'style',
          'stylePresetId',
          'prompt',
          'aspectRatio',
          'modelUsed',
          'imagePreviewUrl',
          'likes',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'id',
          'ownerUid',
          'title',
          'style',
          'stylePresetId',
          'prompt',
          'aspectRatio',
          'modelUsed',
          'description',
          'imagePreviewUrl',
          'likes',
          'createdAt',
          'updatedAt'
        ])
        && data.id is string
        && data.id == artworkId
        && isValidId(data.id)
        && data.ownerUid is string
        && data.ownerUid == userId
        && data.ownerUid == request.auth.uid
        && data.ownerUid.size() >= 1
        && data.ownerUid.size() <= 128
        && data.title is string
        && data.title.size() >= 1
        && data.title.size() <= 120
        && data.style is string
        && data.style.size() >= 1
        && data.style.size() <= 100
        && data.stylePresetId is string
        && data.stylePresetId.size() >= 1
        && data.stylePresetId.size() <= 64
        && data.prompt is string
        && data.prompt.size() >= 1
        && data.prompt.size() <= 1000
        && data.aspectRatio is string
        && data.aspectRatio in ['1:1', '4:3', '3:4', '16:9', '9:16', '4:1', '1:4']
        && data.modelUsed is string
        && data.modelUsed.size() >= 1
        && data.modelUsed.size() <= 80
        && (!('description' in data) || (data.description is string && data.description.size() <= 600))
        && data.imagePreviewUrl is string
        && data.imagePreviewUrl.size() >= 10
        && data.imagePreviewUrl.size() <= 500000
        && data.likes is number
        && data.likes >= 0
        && data.likes <= 1000000
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // 4. Collection Rules
    match /users/{userId} {
      allow get: if isValidId(userId) && isOwner(userId);
      allow list: if false;

      allow create: if isOwner(userId)
        && isValidId(userId)
        && isValidPublicProfile(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isOwner(userId)
        && isValidId(userId)
        && isValidPublicProfile(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'displayName',
          'photoURL',
          'preferredStyleId',
          'customStylePrompt',
          'bio',
          'updatedAt'
        ]);

      allow delete: if isValidId(userId) && isOwner(userId);

      // Isolated PII subcollection
      match /private/{docId} {
        allow get: if isValidId(userId) && isValidId(docId) && docId == 'account' && isOwner(userId);
        allow list: if false;

        allow create: if isOwner(userId)
          && isValidId(userId)
          && isValidId(docId)
          && docId == 'account'
          && isValidPrivateAccount(incoming(), userId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && exists(/databases/$(database)/documents/users/$(userId));

        allow update: if isOwner(userId)
          && isValidId(userId)
          && isValidId(docId)
          && docId == 'account'
          && isValidPrivateAccount(incoming(), userId)
          && incoming().uid == existing().uid
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['email', 'updatedAt']);

        allow delete: if isValidId(userId) && isValidId(docId) && docId == 'account' && isOwner(userId);
      }

      // Personal Cat Passports
      match /cats/{catId} {
        allow get: if isValidId(userId) && isValidId(catId) && isOwner(userId);
        allow list: if isOwner(userId) && existing().ownerUid == request.auth.uid;

        allow create: if isOwner(userId)
          && isValidId(userId)
          && isValidId(catId)
          && isValidCatProfile(incoming(), userId, catId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && exists(/databases/$(database)/documents/users/$(userId));

        allow update: if isOwner(userId)
          && isValidId(userId)
          && isValidId(catId)
          && isValidCatProfile(incoming(), userId, catId)
          && incoming().id == existing().id
          && incoming().ownerUid == existing().ownerUid
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'name',
            'breed',
            'coatPattern',
            'eyeColor',
            'distinctiveMarks',
            'updatedAt'
          ]);

        allow delete: if isValidId(userId) && isValidId(catId) && isOwner(userId);
      }

      // Personal Cat Artworks Cloud Gallery
      match /artworks/{artworkId} {
        allow get: if isValidId(userId) && isValidId(artworkId) && isOwner(userId);
        allow list: if isOwner(userId) && existing().ownerUid == request.auth.uid;

        allow create: if isOwner(userId)
          && isValidId(userId)
          && isValidId(artworkId)
          && isValidArtworkMeta(incoming(), userId, artworkId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && exists(/databases/$(database)/documents/users/$(userId));

        allow update: if isOwner(userId)
          && isValidId(userId)
          && isValidId(artworkId)
          && isValidArtworkMeta(incoming(), userId, artworkId)
          && incoming().id == existing().id
          && incoming().ownerUid == existing().ownerUid
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && (
            incoming().diff(existing()).affectedKeys().hasOnly(['likes', 'updatedAt'])
            || incoming().diff(existing()).affectedKeys().hasOnly(['title', 'description', 'updatedAt'])
          );

        allow delete: if isValidId(userId) && isValidId(artworkId) && isOwner(userId);
      }
    }
  }
}
